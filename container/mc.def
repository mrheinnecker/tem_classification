# MinIO client (mc) + procps (`ps` is needed by Nextflow trace/report/timeline).
# Builds on top of the existing EasyBuild module snapshot (rockylinux:8), so mc and its
# environment stay exactly the same. mc lives in
# /g/easybuild/x86_64/Rocky/8/haswell/software/mc/2024-05-03T11-21-07Z/mc

Bootstrap: localimage
From: /g/schwab/marco/container_devel/EMBL_mc_2024-05-03T11-21-07Z.sif

%labels
    Author marco
    Tool MinIO client (mc) RELEASE.2024-05-03T11-21-07Z + procps

%post
    dnf install -y procps-ng && dnf clean all

%test
    ps --version
    /g/easybuild/x86_64/Rocky/8/haswell/software/mc/2024-05-03T11-21-07Z/mc --version
