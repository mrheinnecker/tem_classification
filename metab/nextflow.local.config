/*
 * Local (non-Slurm) overrides for the minimal launcher.sh test run.
 * Neutralises the `executor = 'slurm'` set by ampliseq_orientation.config
 * so nf-core/ampliseq runs in the foreground on this machine.
 */
apptainer {
    pullTimeout = '180m'
}

process {
    executor = 'local'
    maxForks = 4
}