params {
    ampliseq_results = "/home/rheinnec/ampliseq_pilot/results"
    silva_db         = "/mnt/c/projects/biobank/metab_refdb/silva_nr99_v138.2_toGenus_trainset.fa.gz"
    pr2_db           = "/mnt/c/projects/biobank/metab_refdb/pr2_version_5.1.1_SSU_dada2.fasta.gz"
    min_boot         = 50
    cpus             = 8
    memory           = "16 GB"

    // Same image as ampliseq 2.18.0's DADA2_TAXONOMY (R 4.5, dada2 1.38).
    // On the cluster, point this to a pre-pulled .sif if compute nodes lack internet.
    container_dada2  = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/81/81153df5d53322e6d91b2c4c9bc4da50774fb1d101ead002fe75bb75fc6f036c/data"
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv("NXF_APPTAINER_CACHEDIR") ?: System.getenv("HOME") + "/.apptainer/nxf_cache"}"
}

process {
    container = "${params.container_dada2}"
    executor  = "local"
}

profiles {
    slurm {
        process.executor = "slurm"
        apptainer.runOptions = "--bind /g --bind /scratch"
    }
}
