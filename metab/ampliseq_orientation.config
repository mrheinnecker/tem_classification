/*
 * nf-core/ampliseq 2.18.0 infrastructure and primer-orientation override.
 *
 * The input library contains both paired-end orientations. The stock Illumina
 * Cutadapt command expects only FW-in-R1 / RV-in-R2. Cutadapt 5.2, bundled in
 * ampliseq 2.18.0, can normalize paired reads with --revcomp (it swaps mates
 * when the reverse orientation gives the better primer match).
 *
 * This config is pinned to nf-core/ampliseq 2.18.0 because it mirrors that
 * release's CUTADAPT_BASIC arguments and adds --revcomp.
 */

process {
    executor = 'slurm'

    withName: 'CUTADAPT_BASIC' {
        ext.args = { [
            '--minimum-length 1',
            "-O ${params.cutadapt_min_overlap}",
            "-e ${params.cutadapt_max_error_rate}",
            params.pacbio ? "--rc -g ${meta.fw_primer}...${meta.rv_primer_revcomp}" :
                params.iontorrent ? "--rc -g ${meta.fw_primer}...${meta.rv_primer_revcomp}" :
                params.single_end ? "--rc -g ${meta.fw_primer}" :
                "--revcomp -g ${meta.fw_primer} -G ${meta.rv_primer}",
            params.retain_untrimmed ? '' : '--discard-untrimmed'
        ].join(' ').trim() }
    }
}
