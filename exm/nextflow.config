params {
    main_dir       = "C:/projects/exm_screen"
    input_table    = "C:/projects/exm_screen/exm_images.tsv"
    sheet_mode     = "local"
    sheet_url      = ""
    sheet_name     = ""
    google_key     = "$projectDir/trec-tem-screen-e98a2e03f58b.json"
    collection_table_url = ""
    collection_table_sheet = "exm_collection_table"
    local_collection_table = "C:/projects/exm_screen/exm_collection_table.tsv"
    outdir         = "C:/projects/exm_screen/processed"
    logdir         = "C:/projects/exm_screen/logs/wfEXM_local"
    script_dir     = "$projectDir"
    dryrun         = "TRUE"
    dryrun_n       = 2
    workflow_stage = "discover"

    container_tidyverse = "/g/schwab/marco/container_devel/probeDesign_rtool.sif"
    container_eubi      = "/g/schwab/marco/container_devel/eubibridge.sif"
    container_mc        = "/g/schwab/marco/container_devel/mc_client.sif"
    container_nd2       = "/g/schwab/marco/container_devel/nd2_to_tiff.sif"

    s3_bucket = "s3test/imatrec/central_data_processing/exm"
    publish_dir = "/g/schwab/s3-public/imatrec/central_data_processing/exm"
    zarr_format = 3
    default_x_scale = ""
    default_y_scale = ""
    default_z_scale = ""
    scale_unit = "nm"
    persistent_metadata_dir = "C:/projects/exm_screen/metadata"
}

process {
    withName:CHECKEXISTINGEXMS3FILES {
        container = "${params.container_mc}"
        executor = "local"
    }
    withName:SELECTEXMIMAGES {
        container = "${params.container_tidyverse}"
        executor = "local"
    }
    withName:EXTRACTEXMMETADATA {
        container = "${params.container_nd2}"
    }
    withName:PREPAREEXMINPUT {
        container = "${params.container_nd2}"
    }
    withName:EUBIEXMCONVERSION {
        container = "${params.container_eubi}"
    }
    withName:PATCHEXMOMEZARRMETADATA {
        container = "${params.container_nd2}"
    }
    withName:COLLECTEXMS3FILES {
        container = "${params.container_mc}"
        executor = "local"
    }
    withName:MAKEEXMCOLLECTIONTABLE {
        container = "${params.container_tidyverse}"
        executor = "local"
    }
}

singularity {
    enabled = false
}

// run reports, the files are set in exm_main.sh (-with-trace etc.) so they land in the run's logdir.
// trace / report / timeline need `ps` in every container used by a process.
trace {
    enabled   = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
    overwrite = true
}

report {
    enabled   = true
    overwrite = true
}

timeline {
    enabled   = true
    overwrite = true
}

dag {
    enabled   = true
    overwrite = true
}

profiles {
    local {
        executor.name = "local"
        singularity.enabled = false
        params.workflow_stage = "discover"
        params.sheet_mode = "local"
        params.dryrun = "TRUE"
    }

    interactive {
        executor.name = "local"
        singularity.enabled = true
        params.main_dir = "/scratch/rheinnec/exm_screen"
        params.input_table = "/scratch/rheinnec/exm_screen/exm_images.tsv"
        params.outdir = "/scratch/rheinnec/exm_screen/processed"
        params.logdir = "/scratch/rheinnec/exm_screen/logs/wfEXM_interactive"
        params.script_dir = "/g/schwab/marco/repos/tem_classification/exm"
        params.persistent_metadata_dir = "/g/schwab/marco/central_data_processing/exm/metadata"
        params.workflow_stage = "process"
        params.sheet_mode = "google"
        params.dryrun = "FALSE"
    }

    cluster {
        singularity.enabled = true
        executor.name = "slurm"
        executor.perTaskReserve = false
        executor.perJobMemLimit = true
        executor.queueSize = 30
        executor.submitRateLimit = "3 sec"

        params.main_dir = "/scratch/rheinnec/exm_screen"
        params.input_table = "/scratch/rheinnec/exm_screen/exm_images.tsv"
        params.outdir = "/scratch/rheinnec/exm_screen/processed"
        params.logdir = "/scratch/rheinnec/exm_screen/logs/wfEXM_cluster"
        params.script_dir = "/g/schwab/marco/repos/tem_classification/exm"
        params.persistent_metadata_dir = "/g/schwab/marco/central_data_processing/exm/metadata"
        params.workflow_stage = "all"
        params.sheet_mode = "google"
        params.dryrun = "FALSE"
    }
}
